# Server-only Firebase service account credentials; configure these in Render.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with escaped \n characters, or as a quoted multiline value.
FIREBASE_PRIVATE_KEY=
# Verified Google email for the initial administrator; remove after saving their team role.
AUTH_BOOTSTRAP_ADMIN_EMAIL=
# Optional key for Gemini-powered audits.
GEMINI_API_KEY=

# Public Render service URL (or HTTPS custom domain), used in extension downloads.
APP_URL=

# Public settings included in newly downloaded extension packages.
# Low allocation warning at or below this remaining quantity.
FS_ALLOCATION_LOW_THRESHOLD=10
# Visible FS tabs refresh every 30 seconds; supported range: 15000–300000 ms.
FS_ALLOCATION_REFRESH_MS=30000
