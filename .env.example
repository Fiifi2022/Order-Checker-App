# Server-only Firebase service account credentials; configure in the host's variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with escaped \n characters, or as a quoted multiline value.
FIREBASE_PRIVATE_KEY=
# Verified Google email for the initial administrator; remove after saving their team role.
AUTH_BOOTSTRAP_ADMIN_EMAIL=
# Optional key for Gemini-powered audits.
GEMINI_API_KEY=

# Public service URL (Railway, Render or HTTPS custom domain), used in extension downloads.
# On Railway, RAILWAY_PUBLIC_DOMAIN is also detected automatically when APP_URL is unset.
APP_URL=

# Public settings included in newly downloaded extension packages.
# Low allocation warning at or below this remaining quantity.
FS_ALLOCATION_LOW_THRESHOLD=10
# Visible FS tabs refresh every 30 seconds; supported range: 15000–300000 ms.
FS_ALLOCATION_REFRESH_MS=30000

# Server-only product research settings. Existing Gemini key is reused.
PRODUCT_RESEARCH_MODEL=gemini-3.8-flash
# Total optional research budget, 100–10000 ms. One attempt per stage; no automatic 429 retries.
PRODUCT_RESEARCH_TIMEOUT_MS=3500
# Opt-in only: Google Search grounding can incur separate provider charges.
PRODUCT_RESEARCH_GOOGLE_SEARCH=false
PRODUCT_RESEARCH_SEARCH_MODEL=gemini-3.8-flash

# Optional website General Auditor model override. Blank keeps the existing model.
# Does not change Vaccine Checker, fulfilment-only or public-search configuration.
GENERAL_AUDITOR_MODEL=
