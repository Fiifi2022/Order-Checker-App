{
  "manifest_version": 3,
  "name": "OrderCheck",
  "version": "2.3.8",
  "description": "OrderCheck side panel with product-specific General Auditor verification and live FS allocation support.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://fulfillment-gh1-production.platform.flyzipline.com/*",
    "https://fulfillment-gh2-production.platform.flyzipline.com/*",
    "https://fulfillment-gh3-production.platform.flyzipline.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "OrderCheck",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://fulfillment-gh1-production.platform.flyzipline.com/*",
        "https://fulfillment-gh2-production.platform.flyzipline.com/*",
        "https://fulfillment-gh3-production.platform.flyzipline.com/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://fulfillment-gh1-production.platform.flyzipline.com/*",
        "https://fulfillment-gh2-production.platform.flyzipline.com/*",
        "https://fulfillment-gh3-production.platform.flyzipline.com/*"
      ],
      "js": [
        "fs-content.js"
      ]
    }
  ],
  "options_page": "popup.html"
}
